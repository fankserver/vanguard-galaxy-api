<Project Sdk="Microsoft.NET.Sdk">
  <!--
    EWTest: development-only in-game E2E harness for VGModAPI.

    This is NOT part of the shipped API and is never built by CI (`make test` /
    `make build`), because it needs the installed game's BepInEx/Unity reference
    assemblies (linked into VGModAPI/lib on the game machine). It is built and
    launched only by the opt-in `make e2e` target on the machine that has the
    game, mirroring how `make check-bindings` needs the installed assembly.

    It consumes only the public VGModAPI.Abstractions contract, so it treats the
    game+API as a black box — exactly the right posture for detecting a future
    game-update break. No VGModAPI internals or VGModAPI.Unity are referenced here.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>EWTest</RootNamespace>
    <AssemblyName>EWTest</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../VGModAPI.Abstractions/VGModAPI.Abstractions.csproj" Private="false" />
    <Reference Include="BepInEx"><HintPath>../VGModAPI/lib/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>../VGModAPI/lib/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>../VGModAPI/lib/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>../VGModAPI/lib/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
