<Project Sdk="Microsoft.NET.Sdk">
  <!-- Independent example author demonstrating read-only observation of the running game. The
       Unity-free injected consumers live in Consumers/ and build as their own assembly; keep them
       out of this project's default source glob. Never part of the shipped API package. -->
  <PropertyGroup><TargetFramework>netstandard2.1</TargetFramework><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <Compile Remove="Consumers/**" />
    <ProjectReference Include="../../VGModAPI.Abstractions/VGModAPI.Abstractions.csproj" Private="false" />
    <Reference Include="BepInEx"><HintPath>../../VGModAPI/lib/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>../../VGModAPI/lib/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>../../VGModAPI/lib/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
