<Project Sdk="Microsoft.NET.Sdk">
  <!-- Variant B: the SAME source as ../Plugin.cs, compiled with AUTHOR_B into a separately loaded
       assembly with its own BepInEx ID. Both variants register identical author-local IDs; the API
       scopes every declaration to the provider that registered it, so neither can touch the other's
       rows. It is never part of the shipped API package. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>StationCommerceB</AssemblyName>
    <DefineConstants>$(DefineConstants);AUTHOR_B</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Plugin.cs" Link="Plugin.cs" />
    <ProjectReference Include="../../../VGModAPI.Abstractions/VGModAPI.Abstractions.csproj" Private="false" />
    <Reference Include="BepInEx"><HintPath>../../../VGModAPI/lib/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>../../../VGModAPI/lib/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>../../../VGModAPI/lib/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
